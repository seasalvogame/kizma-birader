{
  // Kızma Birader game server (docs/architecture/CLOUDFLARE_ARCHITECTURE.md).
  // Local:  npx wrangler dev   (secrets / dev switches in .dev.vars, never committed)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kizmabirader-game-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "MATCH_ROOM", "class_name": "MatchRoom" }]
  },
  // Free plan: Durable Objects need the SQLite storage backend.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }],
  "vars": {
    // Public values only. Secrets go through `wrangler secret put` (never in this file).
    "SUPABASE_URL": "https://eoujnamlwgbtlwigtjxx.supabase.co",
    // Development match creation (no matchmaker yet). Requires a valid Supabase JWT
    // of one of the seated players. Must be "false" in production.
    "ALLOW_DEV_ROUTES": "true",
    "BOT_DELAY_MS": "900"
  }
}
