extends TestCase
## Parity with the TypeScript engine: replays shared/rules_test_vectors
## (generated by server/game-engine/scripts/gen-vectors.ts). Every event,
## error and state hash must match exactly.

var E := GameEngine.new()


func _load(file: String) -> Dictionary:
	var text := FileAccess.get_file_as_string(repo_path("shared/rules_test_vectors/" + file))
	var parsed: Variant = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		fail("cannot read %s" % file)
		return {}
	return parsed


func _setup(setup: Dictionary) -> Dictionary:
	var options := {}
	if setup.has("players"):
		options["players"] = int(setup["players"])
	if setup.has("seats"):
		options["seats"] = setup["seats"]
	if setup.has("ruleset"):
		options["ruleset"] = setup["ruleset"]
	if setup.has("first_seat"):
		options["first_seat"] = int(setup["first_seat"])
	var s := GameState.create(options)
	var pawns: Dictionary = setup.get("pawns", {})
	for c: String in pawns:
		var steps: Array = []
		for v: Variant in pawns[c]:
			steps.append(int(v))
		s["pawns"][c] = steps
	return s


func test_scenarios_match_the_typescript_engine() -> void:
	var data := _load("scenarios.json")
	var scenarios: Array = data.get("scenarios", [])
	assert_true(scenarios.size() >= 30, "scenario count %d" % scenarios.size())
	for sc: Dictionary in scenarios:
		var s := _setup(sc["setup"])
		if s.is_empty():
			fail("%s: setup failed: %s" % [sc["name"], GameState.last_error])
			continue
		assert_eq(StateCanon.canonical(s), sc["initial"], "%s initial" % sc["name"])
		var actions: Array = sc["actions"]
		var expected: Array = sc["expect"]
		for i in actions.size():
			var a: Dictionary = actions[i]
			var action := {"type": a["type"], "seat": int(a.get("seat", s["turn"]["seat"])),
				"turn_id": int(a.get("turn_id", s["turn"]["turn_id"])), "pawn": int(a.get("pawn", 0))}
			var r := E.apply(s, action, int(a.get("dice", GameEngine.NO_DICE)))
			var want: Dictionary = expected[i]
			var where := "%s #%d" % [sc["name"], i]
			assert_eq(r["ok"], want["ok"], where + " ok")
			if r["ok"]:
				s = r["state"]
				assert_eq(r["events"], want["events"], where + " events")
			else:
				assert_eq(r["error"], want["error"], where + " error")
			assert_eq(StateCanon.canonical(s), want["state"], where + " state")
			assert_eq(StateCanon.state_hash(s), int(want["hash"]), where + " hash")


func test_random_traces_match_step_by_step() -> void:
	var data := _load("traces.json")
	var traces: Array = data.get("traces", [])
	assert_true(traces.size() >= 60, "trace count %d" % traces.size())
	var steps := 0
	for t: Dictionary in traces:
		var s := GameState.create({"players": int(t["players"]), "first_seat": int(t["first_seat"])})
		var codes: PackedStringArray = String(t["actions"]).split(" ")
		var hashes: Array = t["hashes"]
		var ok := true
		for i in codes.size():
			var code := codes[i]
			var seat := int(s["turn"]["seat"])
			var turn_id := int(s["turn"]["turn_id"])
			var r: Dictionary
			match code[0]:
				"r":
					r = E.apply(s, {"type": "roll", "seat": seat, "turn_id": turn_id}, int(code.substr(1)))
				"m":
					r = E.apply(s, {"type": "move", "seat": seat, "turn_id": turn_id, "pawn": int(code.substr(1))})
				"t":
					var dice := int(code.substr(1)) if code.length() > 1 else GameEngine.NO_DICE
					r = E.apply(s, {"type": "timeout", "seat": seat, "turn_id": turn_id}, dice)
			if not r["ok"]:
				fail("trace %d step %d (%s): %s" % [int(t["seed"]), i, code, r["error"]])
				ok = false
				break
			s = r["state"]
			steps += 1
			if StateCanon.state_hash(s) != int(hashes[i]):
				fail("trace %d diverges at step %d (%s): %s" % [int(t["seed"]), i, code, StateCanon.canonical(s)])
				ok = false
				break
		if ok:
			assert_eq(StateCanon.canonical(s), t["final"], "trace %d final" % int(t["seed"]))
	print("      replayed %d trace steps" % steps)
